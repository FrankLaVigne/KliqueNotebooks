# Copy these lines into the ignored repository-root .env, or inject environment variables.
# Do not put real credentials into this tracked example.
KLIQUE_BASE_URL=https://your-endpoint-host/v1
KLIQUE_GATEWAY_TOKEN=replace-with-your-gateway-token
KLIQUE_PROFILE=replace-with-your-profile
KLIQUE_MODEL_ALIASES=first-profile-alias,second-profile-alias
# Optional: use this exact gateway base instead of deriving it from KLIQUE_BASE_URL.
# KLIQUE_LLM_GATEWAY_URL=https://your-endpoint-host/llm
# Only set codes observed in your own Section 03 responses, when distinct.
# KLIQUE_RATE_LIMIT_CODE=your-observed-rate-limit-code
# KLIQUE_BUDGET_CODE=your-observed-budget-code
